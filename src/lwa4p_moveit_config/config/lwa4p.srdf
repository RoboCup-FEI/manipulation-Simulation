<?xml version="1.0" encoding="UTF-8"?>
<!--This does not replace URDF, and is not an extension of URDF.
    This is a format for representing semantic information about the robot structure.-->
<robot name="lwa4p">

  <!-- GROUPS -->
  <group name="arm">
    <chain base_link="arm_base_link" tip_link="gripper_tcp"/>
  </group>

  <group name="gripper">
    <joint name="gripper_joint"/>
    <joint name="gripper_finger_left_joint"/>
    <joint name="gripper_finger_right_joint"/>
  </group>

  <!-- GROUP STATES -->
  <group_state name="home" group="arm">
    <joint name="arm_1_joint" value="0"/>
    <joint name="arm_2_joint" value="0"/>
    <joint name="arm_3_joint" value="0"/>
    <joint name="arm_4_joint" value="0"/>
    <joint name="arm_5_joint" value="0"/>
    <joint name="arm_6_joint" value="0"/>
  </group_state>

  <group_state name="work1" group="arm">
    <joint name="arm_1_joint" value="0"/>
    <joint name="arm_2_joint" value="0"/>
    <joint name="arm_3_joint" value="1.4735"/>
    <joint name="arm_4_joint" value="0"/>
    <joint name="arm_5_joint" value="0"/>
    <joint name="arm_6_joint" value="0"/>
  </group_state>

  <group_state name="work2" group="arm">
    <joint name="arm_1_joint" value="0"/>
    <joint name="arm_2_joint" value="-0.3094"/>
    <joint name="arm_3_joint" value="1.414"/>
    <joint name="arm_4_joint" value="0.8955"/>
    <joint name="arm_5_joint" value="0"/>
    <joint name="arm_6_joint" value="0"/>
  </group_state>

  <!-- GROUP STATES -->
  <group_state name="open" group="gripper">
    <joint name="gripper_joint" value="0.085"/>
  </group_state>

  <group_state name="tube_15mm" group="gripper">
    <joint name="gripper_joint" value="0.015"/>
  </group_state>

  <group_state name="closed" group="gripper">
    <joint name="gripper_joint" value="0.0"/>
  </group_state>

  <!-- END EFFECTOR -->
  <end_effector name="wsg50" parent_link="gripper_tcp" group="gripper" parent_group="arm"/>


  <!-- Arm links collisions -->
  <disable_collisions link1="arm_1_link" link2="arm_2_link" reason="Adjacent"/>
  <disable_collisions link1="arm_1_link" link2="arm_3_link" reason="Never"/>
  <disable_collisions link1="arm_1_link" link2="arm_podest_link" reason="Adjacent"/>
  <disable_collisions link1="arm_2_link" link2="arm_3_link" reason="Adjacent"/>
  <disable_collisions link1="arm_2_link" link2="arm_4_link" reason="Never"/>
  <disable_collisions link1="arm_2_link" link2="arm_5_link" reason="Never"/>
  <disable_collisions link1="arm_2_link" link2="arm_6_link" reason="Never"/>
  <disable_collisions link1="arm_2_link" link2="arm_podest_link" reason="Never"/>
  <disable_collisions link1="arm_3_link" link2="arm_4_link" reason="Adjacent"/>
  <disable_collisions link1="arm_3_link" link2="arm_5_link" reason="Never"/>
  <disable_collisions link1="arm_3_link" link2="arm_6_link" reason="Never"/>
  <disable_collisions link1="arm_3_link" link2="arm_podest_link" reason="Never"/>
  <disable_collisions link1="arm_4_link" link2="arm_5_link" reason="Adjacent"/>
  <disable_collisions link1="arm_4_link" link2="arm_6_link" reason="Never"/>
  <disable_collisions link1="arm_5_link" link2="arm_6_link" reason="Adjacent"/>

  <!-- FTS-LWA Sensor collisions -->
  <disable_collisions link1="arm_4_link" link2="fts_lwa_base_link" reason="Never"/>
  <disable_collisions link1="arm_5_link" link2="fts_lwa_base_link" reason="Never"/>
  <disable_collisions link1="arm_6_link" link2="fts_lwa_base_link" reason="Adjacent"/>

  <!-- Gripper Connector Plate collisions -->
  <disable_collisions link1="arm_4_link" link2="gripper_connector_link" reason="Never"/>
  <disable_collisions link1="arm_5_link" link2="gripper_connector_link" reason="Never"/>
  <disable_collisions link1="arm_6_link" link2="gripper_connector_link" reason="Adjacent"/>
  <disable_collisions link1="fts_lwa_base_link" link2="gripper_connector_link" reason="Adjacent"/>

  <!-- Gripper Body collisions -->
  <disable_collisions link1="arm_4_link" link2="gripper_base_link" reason="Never"/>
  <disable_collisions link1="arm_5_link" link2="gripper_base_link" reason="Never"/>
  <disable_collisions link1="arm_6_link" link2="gripper_base_link" reason="Never"/>
  <disable_collisions link1="fts_lwa_base_link" link2="gripper_base_link" reason="Never"/>
  <disable_collisions link1="gripper_connector_link" link2="gripper_base_link" reason="Adjacent"/>

  <!-- Gripper Carriage and Fingers collisions -->
  <disable_collisions link1="gripper_base_link" link2="gripper_gripper_left" reason="Adjacent"/>
  <disable_collisions link1="gripper_base_link" link2="gripper_gripper_right" reason="Adjacent"/>
  <disable_collisions link1="gripper_gripper_left" link2="gripper_finger_left_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_gripper_right" link2="gripper_finger_right_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_gripper_left" link2="gripper_gripper_right" reason="Never"/>
  <disable_collisions link1="gripper_finger_left_link" link2="gripper_finger_right_link" reason="Never"/>
  <disable_collisions link1="gripper_connector_link" link2="gripper_gripper_left" reason="Never"/>
  <disable_collisions link1="gripper_connector_link" link2="gripper_gripper_right" reason="Never"/>
  <disable_collisions link1="arm_6_link" link2="gripper_gripper_left" reason="Never"/>
  <disable_collisions link1="arm_6_link" link2="gripper_gripper_right" reason="Never"/>
</robot>