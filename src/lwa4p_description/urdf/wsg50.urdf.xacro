<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="wsg_50_xacro" params="name parent *origin tool_point">
    
    <!-- Connector plate from original Schunk assembly -->
    <joint name="${name}_connector_gripper_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${name}_connector_link"/>
    </joint>

    <link name="${name}_connector_link">
      <inertial>
        <mass value="0.01"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
      </inertial>
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0.007"/>
        <geometry>
          <cylinder length="0.014" radius="0.030"/>
        </geometry>
        <material name="schunk_grey"/>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0.007"/>
        <geometry>
          <cylinder length="0.014" radius="0.030"/>
        </geometry>
      </collision>
    </link>

    <joint name="${name}_anterior_gripper_joint" type="fixed">
      <origin xyz="0 0 0.014" rpy="0 0 0"/>
      <parent link="${name}_connector_link"/>
      <child link="${name}_base_link"/>
    </joint>

    <!-- Base link -->
    <link name="${name}_base_link">
      <inertial>
        <mass value="0.95"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://lwa4p_description/meshes/wsg_50/WSG50_BASE_110.stl" scale="1 1 1"/>
        </geometry>
        <material name="schunk_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://lwa4p_description/meshes/wsg_50/WSG50_BASE_110_collision.stl" scale="1.05 1.05 1.05"/>
        </geometry>
      </collision>
    </link>

    <!-- Command joint for ros2_control -->
    <joint name="${name}_joint" type="prismatic">
      <parent link="${name}_base_link"/>
      <child link="${name}_gap_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="0.0" upper="0.110" effort="80" velocity="0.42"/>
    </joint>

    <link name="${name}_gap_link">
      <inertial>
        <mass value="0.01"/>
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
      </inertial>
    </link>

    <!-- Left finger base -->
    <joint name="${name}_finger_left_joint" type="prismatic">
      <parent link="${name}_base_link"/>
      <child link="${name}_gripper_left"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="-0.055" upper="0.055" effort="80" velocity="0.42"/>
      <mimic joint="${name}_joint" multiplier="-0.5" offset="0"/>
    </joint>

    <link name="${name}_gripper_left">
      <inertial>
        <mass value="0.1"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://lwa4p_description/meshes/wsg_50/FINGERHOLD_WSG50.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="schunk_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://lwa4p_description/meshes/wsg_50/FINGERHOLD_WSG50.stl" scale="0.00105 0.00105 0.00105"/>
        </geometry>
      </collision>
    </link>

    <!-- Left finger tip -->
    <joint name="${name}_guide_joint_finger_left" type="fixed">
      <origin xyz="0 0 0.023" rpy="0 0 0"/>
      <parent link="${name}_gripper_left"/>
      <child link="${name}_finger_left_link"/>
    </joint>

    <link name="${name}_finger_left_link">
      <inertial>
        <mass value="0.1"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0.001" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://lwa4p_description/meshes/wsg_50/WSG50_FINGER.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="schunk_grey"/>
      </visual>
      <collision>
        <origin xyz="-0.001 0 0.001" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://lwa4p_description/meshes/wsg_50/WSG50_FINGER.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <!-- Right finger base -->
    <joint name="${name}_finger_right_joint" type="prismatic">
      <parent link="${name}_base_link"/>
      <child link="${name}_gripper_right"/>
      <origin xyz="0 0 0" rpy="0 0 3.14159"/>
      <axis xyz="-1 0 0"/>
      <limit lower="-0.055" upper="0.055" effort="80" velocity="0.42"/>
      <mimic joint="${name}_joint" multiplier="0.5" offset="0"/>
    </joint>

    <link name="${name}_gripper_right">
      <inertial>
        <mass value="0.1"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://lwa4p_description/meshes/wsg_50/FINGERHOLD_WSG50.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="schunk_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://lwa4p_description/meshes/wsg_50/FINGERHOLD_WSG50.stl" scale="0.00105 0.00105 0.00105"/>
        </geometry>
      </collision>
    </link>

    <!-- Right finger tip -->
    <joint name="${name}_guide_joint_finger_right" type="fixed">
      <origin xyz="0 0 0.023" rpy="0 0 0"/>
      <parent link="${name}_gripper_right"/>
      <child link="${name}_finger_right_link"/>
    </joint>

    <link name="${name}_finger_right_link">
      <inertial>
        <mass value="0.1"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0.001" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://lwa4p_description/meshes/wsg_50/WSG50_FINGER.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="schunk_grey"/>
      </visual>
      <collision>
        <origin xyz="-0.001 0 0.001" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://lwa4p_description/meshes/wsg_50/WSG50_FINGER.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <!-- Tool center point -->
    <joint name="${name}_tcp_joint" type="fixed">
      <origin xyz="0 0 0.145" rpy="0 0 0"/>
      <parent link="${name}_base_link"/>
      <child link="${tool_point}"/>
    </joint>
    <link name="${tool_point}"/>

  </xacro:macro>
</robot>